# Portainer UI simulation - Property syntax for easy copy/paste into Portainer UI
portainer_sub=portainer-sub-value
portainer_hard=portainer-hard-value
portainer_undeclared=portainer-undeclared-value
EIAB_ENV=staging
# Location where the secrets and extra volume is found for app tse
EIAB_EXTRA=<host-filesystem-location>/eiab/tse